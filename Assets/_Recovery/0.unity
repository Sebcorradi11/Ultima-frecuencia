  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaFrecuencia.PipNPC
  nombre: Pip
  primeraConversacion:
  - "\xA1Pii-pii! \xA1DIAL-7, despertaste! Rosa dej\xF3 grabaciones por toda la subestaci\xF3n."
  - "La ciudad est\xE1 partida en frecuencias. Gir\xE1 tu dial con Q y E: lo que ves transparente se vuelve s\xF3lido."
  - "Psst... arriba de la escalera de colores hay una cinta escondida. \xA1Seguime!"
  conversacionRepetida:
  - "\xA1Si algo parece imposible, prob\xE1 con otra frecuencia!"
  radioDeambular: 1.2
  velocidadDeambular: 0.35
  velocidadVuelo: 4
  puntoSecreto: {fileID: 1560426184}
  tiempoSenalando: 2
  avisoInteraccion: {fileID: 2123955143}
  sprite: {fileID: 1305694403}
